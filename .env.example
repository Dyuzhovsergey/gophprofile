# ============================================================
# GophProfile environment for Docker Compose
# ============================================================
#
# Создание локального файла:
#
#   cp .env.example .env
#
# Файл .env не добавляется в Git.
#
# Адреса postgres, minio, rabbitmq и jaeger ниже являются
# именами сервисов внутри сети Docker Compose.

# =========================
# Application
# =========================

# Server слушает порт 8080 внутри контейнера.
# На хосте он доступен через localhost:9090.
GOPHPROFILE_SERVER_ADDRESS=:8080

# Уровень логирования: debug, info, warn, error.
GOPHPROFILE_LOG_LEVEL=debug

# Максимальный размер загружаемого файла.
# 10485760 байт = 10 MiB.
GOPHPROFILE_MAX_UPLOAD_SIZE_BYTES=10485760

# Адрес отдельного HTTP-сервера метрик worker.
GOPHPROFILE_WORKER_METRICS_ADDRESS=:9091

# =========================
# Rate Limiting
# =========================

GOPHPROFILE_RATE_LIMIT_ENABLED=true
GOPHPROFILE_RATE_LIMIT_REQUESTS_PER_SECOND=20
GOPHPROFILE_RATE_LIMIT_BURST=40

# =========================
# Circuit Breaker
# =========================

GOPHPROFILE_CIRCUIT_BREAKER_ENABLED=true
GOPHPROFILE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
GOPHPROFILE_CIRCUIT_BREAKER_OPEN_TIMEOUT=30s

# =========================
# PostgreSQL
# =========================

# Внутри Docker Compose PostgreSQL доступен по имени postgres
# и внутреннему порту 5432.
GOPHPROFILE_DATABASE_DSN=postgres://gophprofile:gophprofile@postgres:5432/gophprofile?sslmode=disable

# =========================
# MinIO / S3
# =========================

# Внутри Docker Compose MinIO доступен по имени minio.
GOPHPROFILE_S3_ENDPOINT=http://minio:9000
GOPHPROFILE_S3_REGION=us-east-1
GOPHPROFILE_S3_ACCESS_KEY=minioadmin
GOPHPROFILE_S3_SECRET_KEY=minioadmin
GOPHPROFILE_S3_BUCKET=avatars
GOPHPROFILE_S3_USE_PATH_STYLE=true

# =========================
# RabbitMQ
# =========================

# Внутри Docker Compose RabbitMQ доступен по имени rabbitmq.
GOPHPROFILE_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

GOPHPROFILE_RABBITMQ_EXCHANGE=avatars.exchange

GOPHPROFILE_RABBITMQ_UPLOAD_QUEUE=avatar.uploaded.queue
GOPHPROFILE_RABBITMQ_UPLOAD_ROUTING_KEY=avatar.uploaded

GOPHPROFILE_RABBITMQ_DELETE_QUEUE=avatar.deleted.queue
GOPHPROFILE_RABBITMQ_DELETE_ROUTING_KEY=avatar.deleted

# =========================
# OpenTelemetry tracing
# =========================

GOPHPROFILE_OTEL_ENABLED=true

# Внутри Docker Compose Jaeger доступен по имени jaeger.
GOPHPROFILE_OTEL_EXPORTER_ENDPOINT=jaeger:4318

# GOPHPROFILE_SERVICE_NAME намеренно не задаётся.
#
# Server автоматически использует:
#   gophprofile-server
#
# Worker автоматически использует:
#   gophprofile-worker